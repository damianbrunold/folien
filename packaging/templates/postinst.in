#!/bin/sh
# postinst for @PKG@ (generated by packaging/package-deb.scm).
set -e

PKG=@PKG@
APP=/opt/@PKG@
CONF=/etc/@PKG@/config.scm
DATA=/var/lib/@PKG@
SERVICES="@SERVICES@"
TIMERS="@TIMERS@"

have_systemd() { [ -d /run/systemd/system ]; }

# The config still holds the example DB password: the admin has not filled
# it in yet, so the service is not started.
configured() {
  [ -e "$CONF" ] &&
    ! grep -q '^[[:space:]]*(define[[:space:]][[:space:]]*db-password[[:space:]][[:space:]]*"change-me")' "$CONF"
}

case "$1" in
  configure)
    if ! getent passwd "$PKG" >/dev/null; then
      adduser --system --group --home "$DATA" --no-create-home \
              --gecos "$PKG service" --quiet "$PKG"
    fi

    # data-dir: uploaded images and videos, backups
    mkdir -p "$DATA"
    chown "$PKG:$PKG" "$DATA"
    chmod 0750 "$DATA"

    mkdir -p "/etc/$PKG"
    if [ ! -e "$CONF" ]; then
      secret=$("$APP/bin/scm" "$APP/app/bin/gen-secret.scm")
      sed "s|@SECRET_PLACEHOLDER@|$secret|" \
          "/usr/share/$PKG/config.default.scm" > "$CONF.new"
      chown "root:$PKG" "$CONF.new"
      chmod 0640 "$CONF.new"
      mv "$CONF.new" "$CONF"
      echo "$PKG: created $CONF (with a fresh session-secret)."
    fi

    if have_systemd; then
      systemctl daemon-reload
      systemctl enable $SERVICES $TIMERS >/dev/null 2>&1 || true
      if configured; then
        for s in $SERVICES; do
          systemctl restart "$s" || echo "$PKG: could not start $s (see journalctl -u $s)"
        done
        for t in $TIMERS; do systemctl start "$t" || true; done
      else
        echo "$PKG: edit $CONF (database credentials, url-prefix),"
        echo "$PKG: create the first admin: sudo -u $PKG $PKG-admin seed-admin <name>"
        echo "$PKG: then: systemctl start $SERVICES $TIMERS"
      fi
    fi
    ;;
esac

exit 0
