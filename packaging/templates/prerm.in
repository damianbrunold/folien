#!/bin/sh
# prerm for @PKG@ (generated by packaging/package-deb.scm). Stops the
# service before its files are replaced or removed.
set -e

SERVICES="@SERVICES@"
TIMERS="@TIMERS@"

if [ -d /run/systemd/system ]; then
  case "$1" in
    remove|deconfigure)
      systemctl stop $TIMERS $SERVICES >/dev/null 2>&1 || true
      systemctl disable $TIMERS $SERVICES >/dev/null 2>&1 || true
      ;;
    upgrade|failed-upgrade)
      systemctl stop $TIMERS $SERVICES >/dev/null 2>&1 || true
      ;;
  esac
fi

exit 0
